N = int(input())
for i in range(1, N + 1):
    if (i == 1):
        space = N-i
        row = " " * (space) + "* "
    elif (i == N):
        value = N
        row = "* " * value
    else:
        space = N-i
        hspace = 2*(i)-4
        row = " " * (space) + "* " + " " * (hspace) + "* "
    print(row)
