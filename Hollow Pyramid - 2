N = int(input())
for i in range(1, N + 1):
    if (i == 1):
        row = str(i) + " "
    else:
        space = i-2
        value = str(i) + " "
        row = value + "  " * space + value
    print(row)
for i in range(1, N):
    num = N-i
    if (i == N-1):
        row = str(1) + " "
    else:
        space = (N-1)-(i+1)
        value = str(num) + " "
        row = value + "  " * space + value
    print(row)
