N = int(input())
for i in range(1, N + 1):
    if (i == 1):
        space = N-1
        row = " " * (space) + "* "
    else:
        space = N-i
        hspace = 2*(i-2)
        row = " " * space + "* " + " " * hspace + "* "
    print(row)
for i in range(2, N + 1):
    if (i == N):
        space = N-1
        row = " " * space + "* "
    else:
        space = i-1
        hspace = 2*(N-i-1)
        row = " " * space + "* " + " " * hspace + "* "
    print(row)
