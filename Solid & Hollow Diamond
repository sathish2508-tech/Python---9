N = int(input())
for i in range(1, N + 1):
    if (i == 1):
        space = N-i
        row = " " * space + "* "
    else:
        space = N-i
        row = " " * space + "* " * i 
    print(row)
for i in range(1, N):
    if (i == N-1):
        space = i
        row = " " * space + "* "
    else:
        space = i
        hspace = N-i-2
        row = " " * space + "* " + "  " * hspace + "* "
    print(row)
