N = int(input())
for i in range(1, N + 1):
    if (i == 1):
        space = N-i
        value = str(1) + " "
        row = "  " * space + value
    else:
        space = N-i
        hspace = i-2
        value = str(i) + " "
        row = "  " * space + value + "  " * hspace + value
    print(row)
for i in range(1, N):
    if (i == N-1):
        space = N-1
        value = str(1) + " "
        row = "  " * space + value
    else:
        space = i
        hspace = N-i-2
        value = str(N-i) + " "
        row = "  " * space + value + "  " * hspace + value
    print(row)
