N = int(input())
for i in range(1, N + 1):
    if (i == 1):
        space = 2*(N-i)
        row = "* " + "  " * space + "* "
    elif (i == N):
        star = 2*(N)
        row = "* " * star
    else:
        first_hspace = i-2
        second_hspace = i-2
        space = 2*(N-i)
        row = "* " + "  " * first_hspace + "* " + "  " * space + "* " + "  " * second_hspace + "* "
    print(row)
